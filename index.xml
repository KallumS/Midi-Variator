<?xml version="1.0" encoding="utf-8"?>
<!--
  ReaPack index for Midi Variator.

  Add this repository in REAPER with Extensions > ReaPack > Import repositories,
  pasting the raw URL of this file on the default branch:

    https://raw.githubusercontent.com/KallumS/Midi-Variator/main/index.xml

  That URL only resolves once this file is on the default branch.

  Each <source> is pinned to a commit rather than a branch, so an installed
  version is the exact set of files that was tested and cannot change
  underneath anyone. Publishing a new version means adding a <version> block
  with a fresh commit hash - never editing an existing one.

  The four files are one package and install into one folder, because the
  main script loads the other three from beside itself.

  ReaPack keys an installed package by its NAME, so renaming the script is
  not an upgrade. Rename sparingly.
-->
<index version="1" name="Midi Variator">
  <category name="MIDI Editor">

    <reapack name="Midi Variator.lua" type="script" desc="Midi Variator">
      <version name="1.0" author="kallums" time="2026-09-29T20:00:00Z">
        <changelog><![CDATA[First release. Makes small variations of a MIDI item - melodies, chords, piano parts or drums - each made from the original, so twenty in a row still sound like it. Choose how much may change and what (notes, rhythm, added or left-out notes, chords, timing, velocity, lengths) and where in the phrase; preview the batch against the original; make them after it on the same track. Every variation carries its original, so it can be varied again or put back. Needs ReaImGui.]]></changelog>
        <source main="main" file="Midi Variator.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/f5c8b40c55ada0cc72aadfbfe901979ab08158ac/reascripts/Midi%20Variator.lua</source>
        <source file="mv_theory.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/f5c8b40c55ada0cc72aadfbfe901979ab08158ac/reascripts/mv_theory.lua</source>
        <source file="mv_vary.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/f5c8b40c55ada0cc72aadfbfe901979ab08158ac/reascripts/mv_vary.lua</source>
        <source file="mv_place.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/f5c8b40c55ada0cc72aadfbfe901979ab08158ac/reascripts/mv_place.lua</source>
      </version>
      <version name="1.1" author="kallums" time="2026-09-29T23:00:00Z">
        <changelog><![CDATA[A Scale step. It shows the scale it heard in your clip, and you can pick any root and any of ScaleView's sixteen scales (modes, pentatonics, blues and more). With "Bring the original into this scale" the variations pivot to the new scale - C major into C minor turns every E into Eb - while the original kept inside each variation stays your real one. "Stay in the original's notes" uses only the notes your clip already plays. A step to a neighbouring note is never more than a major third.]]></changelog>
        <source main="main" file="Midi Variator.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/fdcaad87c14f8a4b7b1f5b944026b8a2d11b48c9/reascripts/Midi%20Variator.lua</source>
        <source file="mv_theory.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/fdcaad87c14f8a4b7b1f5b944026b8a2d11b48c9/reascripts/mv_theory.lua</source>
        <source file="mv_vary.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/fdcaad87c14f8a4b7b1f5b944026b8a2d11b48c9/reascripts/mv_vary.lua</source>
        <source file="mv_place.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/fdcaad87c14f8a4b7b1f5b944026b8a2d11b48c9/reascripts/mv_place.lua</source>
      </version>
      <version name="1.1.1" author="kallums" time="2026-09-30T09:00:00Z">
        <changelog><![CDATA[Fix: "Vary selected in place" on pasted (pooled) copies, or on items playing a .mid file, stopped with a ReaScript error ("MediaItem expected"). The "Varied N items in place" message now shows too.]]></changelog>
        <source main="main" file="Midi Variator.lua">https://raw.githubusercontent.com/KallumS/Midi-Variator/fbd0d492ec184ccbf1726b0464b2488643e9a852/reascripts/Midi%20Variator.lua</source>
